diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 3b4d5bd..962463e 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,7 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+#include "freq_array_stat.h"
 
 uint64
 sys_exit(void)
@@ -91,3 +92,60 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+
+
+
+
+uint64
+sys_countFreq(void){
+
+  // read the string
+  uint64 str_ptr ;
+  argaddr(0,&str_ptr);
+
+  uint64 dest_addr;
+  argaddr(1, &dest_addr);
+
+
+
+  struct proc * p = myproc();
+
+    char str[256];
+  if(copyinstr(p->pagetable, str , str_ptr ,sizeof(str))<0){
+      return -1 ;
+    }
+
+
+  // update the struct
+  struct freq_array arr ;
+
+    for(int i =0;i<128;i++){
+
+    arr.counts[i] = 0;
+
+  }
+
+
+  for(int i =0;str[i] != '\0';i++){
+    int index = str[i];
+    arr.counts[index]++;
+
+  }
+
+  for(int i=0;i<128;i++){
+    if (arr.counts[i] > 0)
+    printf("%d: %d ",i,arr.counts[i]);
+  }
+  printf("\n");
+
+
+
+
+  if(copyout(p->pagetable , dest_addr , (char *)&arr ,sizeof(struct freq_array))<0){
+    return -1;
+  }
+
+  return 0;
+
+}
