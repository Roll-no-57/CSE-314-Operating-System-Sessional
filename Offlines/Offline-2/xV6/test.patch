+
+
+
+int main(int argc, char *argv[]) {
+
+
+
+    struct freq_array arr;
+
+  countFreq(argv[1],&arr);
+
+    for(int i=0;i<128;i++){
+      char buf[2];
+      buf[0] = i;
+      buf[1] = '\0';
+      if(arr.counts[i] > 0)
