diff --git a/user/online2.c b/user/online2.c
new file mode 100644
index 0000000..057b695
--- /dev/null
+++ b/user/online2.c
@@ -0,0 +1,30 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+
+
+int main(int argc, char *argv[]) {
+  if (argc != 2) {
+    fprintf(2, "Usage: next <number>\n");
+    exit(1);
+  }
+
+  int n = atoi(argv[1]);
+  if (n > 15 || n <= 0) {
+    fprintf(2, "n must be between 1 and 15\n");
+    exit(1);
+  }
+
+  int nums[15];
+  getRandomNumbers(n, nums);
+
+  printf("Next random numbers are [");
+  for (int i = 0; i < n; i++) {
+    printf("%d", nums[i]);
+    if (i < n - 1) printf(", ");
+  }
+  printf("]\n");
+
+  exit(0);
+}
