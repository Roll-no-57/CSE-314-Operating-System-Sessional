diff --git a/user/test_getpinfo.c b/user/test_getpinfo.c
new file mode 100644
index 0000000..17fc369
--- /dev/null
+++ b/user/test_getpinfo.c
@@ -0,0 +1,149 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/pstat.h"
+
+void
+print_pstat(struct pstat *ps)
+{
+    printf("Process Statistics:\n");
+    printf("PID  InUse  Queue  Tickets(Orig)  Tickets(Curr)  Time Slices\n");
+    printf("---------------------------------------------------------------\n");
+    for (int i = 0; i < 64; i++) {
+        if (ps->inuse[i]) {
+            printf("%d        %d        %d      %d       %d        %d\n",
+                   ps->pid[i], ps->inuse[i], ps->inQ[i],
+                   ps->tickets_original[i], ps->tickets_current[i],
+                   ps->time_slices[i]);
+        }
+    }
+    printf("\n");
+}
+
+int
+main(void)
+{
+    struct pstat ps;
+    int pid;
+
+    printf("=== Initial Process State ===\n");
+    if (getpinfo(&ps) < 0) {
+        printf("getpinfo failed\n");
+        exit(1);
+    }
+    print_pstat(&ps);
+
+    printf("=== Testing fork() ===\n");
+    pid = fork();
+
+    if (pid == 0) {
+        // Child process
+        printf("Child process (PID: %d) starting...\n", getpid());
+
+        // Test settickets in child
+        if (settickets(20) < 0) {
+            printf("Child: settickets failed\n");
+        } else {
+            printf("Child: settickets(20) succeeded\n");
+        }
+
+        // Do some work to consume time slices
+        for (int i = 0; i < 1000000; i++) {
+            // Busy loop to consume CPU time
+            if (i % 100000 == 0) {
+                // Yield occasionally to allow scheduling
+                sleep(1);
+            }
+        }
+
+        printf("Child process finishing...\n");
+        exit(0);
+
+    } else if (pid > 0) {
+        // Parent process
+        printf("Parent process (PID: %d) created child (PID: %d)\n", getpid(), pid);
+
+        // Give child some time to start
+        sleep(2);
+
+        printf("=== Process State After Fork ===\n");
+        if (getpinfo(&ps) < 0) {
+            printf("getpinfo failed after fork\n");
+            exit(1);
+        }
+        print_pstat(&ps);
+
+        // Test settickets in parent
+        if (settickets(15) < 0) {
+            printf("Parent: settickets failed\n");
+        } else {
+            printf("Parent: settickets(15) succeeded\n");
+        }
+
+        // Give more time for processes to run
+        sleep(3);
+
+        printf("=== Process State After Some Runtime ===\n");
+        if (getpinfo(&ps) < 0) {
+            printf("getpinfo failed during runtime\n");
+            exit(1);
+        }
+        print_pstat(&ps);
+
+        // Wait for child to finish
+        printf("Parent waiting for child to finish...\n");
+        wait(0);
+
+        printf("=== Final Process State ===\n");
+        if (getpinfo(&ps) < 0) {
+            printf("getpinfo failed at end\n");
+            exit(1);
+        }
+        print_pstat(&ps);
+
+    } else {
+        printf("Fork failed\n");
+        exit(1);
+    }
+
+    printf("=== Testing Edge Cases ===\n");
+
+    // Test invalid settickets
+    printf("Testing settickets with invalid values...\n");
+    if (settickets(-5) < 0) {
+        printf("settickets(-5) correctly failed\n");
+    } else {
+        printf("settickets(-5) should have failed but didn't\n");
+    }
+
+    if (settickets(0) < 0) {
+        printf("settickets(0) correctly failed\n");
+    } else {
+        printf("settickets(0) should have failed but didn't\n");
+    }
+
+    // Test valid settickets
+    if (settickets(50) == 0) {
+        printf("settickets(50) succeeded\n");
+    } else {
+        printf("settickets(50) failed\n");
+    }
+
+    printf("=== Final State After Edge Case Testing ===\n");
+    if (getpinfo(&ps) < 0) {
+        printf("Final getpinfo failed\n");
+        exit(1);
+    }
+    print_pstat(&ps);
+
+    printf("=== Test Summary ===\n");
+    printf("All tests completed successfully!\n");
+    printf("Key things to verify:\n");
+    printf("1. Child process inherited parent's original_tickets\n");
+    printf("2. settickets() modified original_tickets and reset current_tickets\n");
+    printf("3. time_slices incremented as processes ran\n");
+    printf("4. Process states changed appropriately (RUNNABLE -> RUNNING -> ZOMBIE)\n");
+    printf("5. Invalid settickets calls were rejected\n");
+
+    exit(0);
+}
