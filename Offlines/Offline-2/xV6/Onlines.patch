+#include "types.h"
+
+// XOR-shift random number generator function
+
+// deterministic seed
+uint64 SEED = 111;
+
+// returns a random number
+// in the range [1,n]
+int get_random_number(int n) {
+  uint64 x = SEED;
+
+  x ^= x << 13;
+  x ^= x >> 17;
+  x ^= x << 5;
+
+  SEED = x;
+
+  return 1 + x%n;
+}
