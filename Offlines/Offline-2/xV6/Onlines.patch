+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+#define verbose 0
+
+int main(int argc, char *argv[]) {
+    int tickets = 43; // Default value
+
+    if (argc > 1) {
+        tickets = atoi(argv[1]);
+    }
+
+    int pid = getpid();
+    if (verbose) printf("Process %d: Requesting %d tickets\n", pid, tickets);
+
+    if (settickets(tickets) < 0) {
+        if (verbose) printf("Process %d: Failed to set tickets\n", pid);
+        exit(1);
+    }
+
+    if (verbose) printf("Process %d: Successfully set %d tickets\n", pid, tickets);
+
+    // First fork
+    int child1 = fork();
+    if (child1 == 0) {
+        // In child1
+        if (verbose) printf("Child process 1 (PID %d): Inherited tickets from parent\n", getpid());
+    } else {
+        // Second fork (only in parent)
+        int child2 = fork();
+        if (child2 == 0) {
+            if (verbose) printf("Child process 2 (PID %d): Inherited tickets from parent\n", getpid());
+        } else {
+            // Third fork (only in parent)
+            int child3 = fork();
+            if (child3 == 0) {
+                if (verbose) printf("Child process 3 (PID %d): Inherited tickets from parent\n", getpid());
+            }
+        }
+    }
+
+    // All processes go into same infinite loop
+    int counter = 0;
+    while (1) {
+        counter++;
+        if (counter % 1000000 == 0) {
+            if (verbose) printf("Process %d (tickets=%d): Still running...\n", getpid(), tickets);
+        }
+        if (counter % 10000 == 0) {
+            sleep(1);
+        }
+    }
+
+    exit(0);
+}
diff --git a/user/fork_test.c b/user/fork_test.c
