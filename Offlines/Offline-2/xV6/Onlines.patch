diff --git a/user/fstatdemo.c b/user/fstatdemo.c
new file mode 100644
index 0000000..5256fae
--- /dev/null
+++ b/user/fstatdemo.c
@@ -0,0 +1,51 @@
+/*************************************************************
+ * fstatdemo.c – illustrate how to call fstat() on a file
+ *
+ *   $ fstatdemo README
+ *   size: 1223 bytes
+ *   type: regular file
+ *   inode: 1234
+ *************************************************************/
+
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+static const char *ftype(short type)
+{
+  switch(type) {
+  case T_DIR:   return "directory";
+  case T_FILE:  return "regular file";
+  case T_DEVICE:   return "device";
+  default:      return "unknown";
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  if(argc != 2){
+    fprintf(2, "usage: fstatdemo <path>\n");
+    exit(1);
+  }
+
+  int fd = open(argv[1], 0);            // read-only
+  if(fd < 0){
+    fprintf(2, "fstatdemo: cannot open %s\n", argv[1]);
+    exit(1);
+  }
+
+  struct stat st;
+  if(fstat(fd, &st) < 0){
+    fprintf(2, "fstatdemo: fstat failed\n");
+    close(fd);
+    exit(1);
+  }
+
+  printf("size: %lu bytes\n",   st.size);
+  printf("type: %s\n",         ftype(st.type));
+  printf("inode: %d\n",        st.ino);
+
+  close(fd);
+  exit(0);
+}
