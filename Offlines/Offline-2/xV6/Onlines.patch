+      if (PRINT_SCHEDULING)
+      {
+        printf("CPU %d: Running PID %d (remaining time slice: %d)\n",
+               current_cpuid, current_proc->pid, remaining_time_slice);
+      }
+
+      acquire(&current_proc->lock);
+
+      if (current_proc->state == RUNNABLE)
+      {
+        current_proc->state = RUNNING;
+        c->proc = current_proc;
+        swtch(&c->context, &current_proc->context);
+        c->proc = 0;
+        remaining_time_slice--;
+        current_proc->total_consumed_time_slice++;
+
+        if (PRINT_SCHEDULING)
+        {
+          printf("CPU %d: PID %d completed execution (total time: %d)\n",
+                 current_cpuid, current_proc->pid, current_proc->total_consumed_time_slice);
+        }
+      }
+      else
+      {
+        // Process voluntarily yielded - move UP in priority
+        if (current_proc->current_queue_level == 2 && current_proc->current_tickets > 0)
+        {
+          current_proc->current_queue_level = 1; // move to lottery
+
+          if (PRINT_SCHEDULING)
+          {
+            printf("CPU %d: PID %d voluntarily yielded, promoted to lottery queue\n",
+                   current_cpuid, current_proc->pid);
+          }
+        }
+        current_proc->current_cpuid = -1;
+        release(&current_proc->lock);
+        current_proc = 0;
+      }
+
+      // Check if time slice exhausted
+      if (remaining_time_slice <= 0)
+      {
+        // Time slice exhausted - move DOWN in priority
+        if (current_proc->current_queue_level == 1)
+        {
+          current_proc->current_tickets--;       // use one ticket
+          current_proc->current_queue_level = 2; // move to round-robin
+
+          if (PRINT_SCHEDULING)
+          {
+            printf("CPU %d: PID %d time slice exhausted, demoted to round-robin (tickets left: %d)\n",
+                   current_cpuid, current_proc->pid, current_proc->current_tickets);
+          }
+        }
+        current_proc->current_cpuid = -1;
+        release(&current_proc->lock);
+        current_proc = 0;
+      }
+
+      if (current_proc)
+      {
+        release(&current_proc->lock);
+      }
+    }
+    else
+    {
+      if (PRINT_SCHEDULING)
+        printf("CPU %d: No runnable process found\n", current_cpuid);
+    }
+  }
+}
