--- /dev/null
+++ b/user/fork_test.c
@@ -0,0 +1,68 @@
+// forktest.c - Program to demonstrate fork inherits parent's tickets
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int main(int argc, char *argv[])
+{
+    int parent_tickets = 50; // default
+    
+    if (argc > 1) {
+        parent_tickets = atoi(argv[1]);
+    }
+    
+    printf("Parent %d: Setting %d tickets\n", getpid(), parent_tickets);
+    
+    // Parent sets tickets
+    if (settickets(parent_tickets) < 0) {
+        printf("Parent: Failed to set tickets\n");
+        exit(1);
+    }
+    
+    printf("Parent %d: Successfully set %d tickets\n", getpid(), parent_tickets);
+    
+    // Create a few child processes
+    for (int i = 0; i < 3; i++) {
+        int pid = fork();
+        
+        if (pid == 0) {
+            // Child process - should inherit parent's tickets
+            printf("Child %d: I am child %d, should have inherited %d tickets from parent\n", 
+                   getpid(), i+1, parent_tickets);
+            
+            // Do some work
+            for (int j = 0; j < 500000; j++) {
+                j= j + 1;
+                if (j % 100000 == 0) {
+                    printf("Child %d: Working...\n", getpid());
+                }
+            }
+            
+            printf("Child %d: Finished work\n", getpid());
+            exit(0);
+            
+        } else if (pid > 0) {
+            printf("Parent %d: Created child %d\n", getpid(), pid);
+        } else {
+            printf("Fork failed\n");
+            exit(1);
+        }
+    }
+    
+    // Parent does some work too
+    printf("Parent %d: Doing parent work\n", getpid());
+    for (int i = 0; i < 800000; i++) {
+        int x = i * 2;
+        if (i % 200000 == 0) {
+            printf("Parent %d: Working...\n", getpid());
+        }
+    }
+    
+    // Wait for all children
+    for (int i = 0; i < 3; i++) {
+        wait(0);
+    }
+    
+    printf("Parent %d: All children finished\n", getpid());
+    exit(0);
+}
