+int settickets(struct proc *p, int number)
+{
+
+  int org_tickets = number;
+  int is_negative = 0;
+
+  if (number < 1)
+  {
+    org_tickets = DEFAULT_TICKET_COUNT;
+    is_negative = 1;
+  }
+
+  acquire(&p->lock);
+  p->original_tickets = org_tickets;
+  p->current_tickets = org_tickets;
+  release(&p->lock);
+
+  if (is_negative)
+  {
+    return -1;
+  }
+
+  return 0;
+}
