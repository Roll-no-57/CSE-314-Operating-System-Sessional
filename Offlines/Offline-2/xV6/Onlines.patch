+uint64 sys_setTargetChar(void){
+  int c;
+  argint(0,&c);
+  targetChar = (char)c;
+  return 0;
+}
+
+
+uint64 sys_countTargetFreq(void){
+  uint64 str_ptr ;
+  argaddr(0,&str_ptr);
+
+  struct proc * p = myproc();
+  
+  char str[256];
+  if(copyin(p->pagetable, str , str_ptr ,sizeof(uint64))<0){
+    return -1 ;
+  }
+
+
+  int count  =0;
+
+  for(int i=0;i<256;i++){
+    if(str[i] == '\0'){
+      break;
+    }
+    else {
+      if(str[i] ==  targetChar)
+      {
+        count++;
+      }
+    }
+  }
+  return count;
+}
+
+
+
+int rand_seed =0;
+uint64 sys_setSeed(void){
+  int seed  =0;
+  argint(0, &seed);
+
+  rand_seed = seed;
+
+  return 0;
+}
+
+
+uint64 sys_choice(void){
+  uint64 addr ;
+  argaddr(0,&addr);
+
+  struct array arr ;
+
+  if(copyin(myproc()->pagetable, (char *)&arr , addr ,sizeof(struct array))<0){
+    return -1;
+  }
+
+  rand_seed+=1;
+  int index = rand_seed % arr.len;
+  printf("rand_ssed %d , index %d , len %d \n",rand_seed,index,arr.len);
+
+  return arr.array[index];
+
+}
