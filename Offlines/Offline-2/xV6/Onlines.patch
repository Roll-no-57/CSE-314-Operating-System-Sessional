-// Per-CPU process scheduler.
-// Each CPU calls scheduler() after setting itself up.
-// Scheduler never returns.  It loops, doing:
-//  - choose a process to run.
-//  - swtch to start running that process.
-//  - eventually that process transfers control
-//    via swtch back to the scheduler.
-void
-scheduler(void)
+// Priority boosting function
+void proc_boosting(void)
 {
   struct proc *p;
+  for (p = proc; p < &proc[NPROC]; p++)
+  {
+    acquire(&p->lock);
+    if (p->current_cpuid == -1)
+    {                                           // not currently running
+      p->current_queue_level = 1;               // move to lottery queue
+      p->current_tickets = p->original_tickets; // reset tickets
+    }
+    release(&p->lock);
+  }
+}
+
+// Get total tickets in lottery queue
+int get_ticket_count(void)
+{
+  int ticket_count = 0;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++)
+  {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE && p->current_cpuid == -1 && p->current_queue_level == 1)
+    {
+      ticket_count += p->current_tickets;
+    }
+    release(&p->lock);
+  }
+  return ticket_count;
+}
+
+
+
+void try_lottery_scheduling(struct proc **current_proc_ptr, int *remaining_time_slice, int current_cpuid)
+{
+
+  int ticket_count = get_ticket_count();
+
+  
+  if (ticket_count)
+  {
+    if (PRINT_SCHEDULING)
+      printf("CPU %d: Trying lottery scheduling (total tickets: %d)\n", current_cpuid, ticket_count);
+
+    int lottery_ticket = get_random_number(ticket_count) % ticket_count;
+
+    for (struct proc *p = proc; p < &proc[NPROC]; p++)
+    {
+      acquire(&p->lock);
+      if (p->state == RUNNABLE && p->current_cpuid == -1 && p->current_queue_level == 1)
+      {
+        if (lottery_ticket < p->current_tickets)
+        {
+          *current_proc_ptr = p;
+          p->current_cpuid = current_cpuid;
+          *remaining_time_slice = TIME_LIMIT_1;
+
+          if (PRINT_SCHEDULING)
+          {
+            printf("CPU %d: Lottery selected PID %d (tickets: %d, queue: %d)\n",
+                   current_cpuid, p->pid, p->current_tickets, p->current_queue_level);
+          }
+
+          release(&p->lock);
+          break;
+        }
+        else
+        {
+          lottery_ticket -= p->current_tickets;
+        }
+      }
+      release(&p->lock);
+    }
+  }
+}
+
+void try_round_robin_scheduling(struct proc **current_proc_ptr, int *remaining_time_slice, int current_cpuid, struct proc **round_robin_next_proc_ptr)
+{
+
+  struct proc *round_robin_next_proc = *round_robin_next_proc_ptr;
+
+  if (PRINT_SCHEDULING)
+    printf("CPU %d: Trying round-robin scheduling\n", current_cpuid);
+
+  for (; round_robin_next_proc < &proc[NPROC]; round_robin_next_proc++)
+  {
+    acquire(&round_robin_next_proc->lock);
+    if (round_robin_next_proc->state == RUNNABLE &&
+        round_robin_next_proc->current_cpuid == -1 &&
+        round_robin_next_proc->current_queue_level == 2)
+    {
+
+      *current_proc_ptr = round_robin_next_proc;
+      round_robin_next_proc->current_cpuid = current_cpuid;
+      *remaining_time_slice = TIME_LIMIT_2;
+
+      if (PRINT_SCHEDULING)
+      {
+        printf("CPU %d: Round-robin selected PID %d (queue: %d)\n",
+               current_cpuid, round_robin_next_proc->pid, round_robin_next_proc->current_queue_level);
+      }
+
+      release(&round_robin_next_proc->lock);
+      break;
+    }
+    release(&round_robin_next_proc->lock);
+  }
+  round_robin_next_proc++;
+  if (round_robin_next_proc >= &proc[NPROC])
+  {
+    round_robin_next_proc = proc;
+  }
+
+  *round_robin_next_proc_ptr = round_robin_next_proc;
+}
+
