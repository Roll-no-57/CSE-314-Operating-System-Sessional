+int getpinfo(uint64 user_pstat)
+{
+
+  // we need to update info for each of the process and then send them to user memory
+
+  struct pstat kernel_pstat;
+
+  struct proc *curr_proc = myproc();
+
+  // here we will update the proc array defined at the top
+  for (int i = 0; i < NPROC; i++)
+  {
+    struct proc *p = &proc[i];
+
+    // update the pstat
+
+    // must use proces own lock
+    acquire(&p->lock);
+    kernel_pstat.pid[i] = p->pid;
+    kernel_pstat.inuse[i] = (p->state != UNUSED);
+    kernel_pstat.inQ[i] = p->current_queue_level;
+    kernel_pstat.tickets_original[i] = p->original_tickets;
+    kernel_pstat.tickets_current[i] = p->current_tickets;
+    kernel_pstat.time_slices[i] = p->total_consumed_time_slice;
+    release(&p->lock);
+  }
+
+  // Now pass this pstat to the user level by copyout
+
+  if (copyout(curr_proc->pagetable, user_pstat, (char *)&kernel_pstat, sizeof(struct pstat)) < 0)
+  {
+    // return -1 if fail
+    return -1;
+  }
+
+  // return 0 if succesfull
+  return 0;
+}
